# ============================================================
# NutriScan AI — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nutriscan

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# --- Cerebras (fast free LLM — best for browser automation) ---
# Get a FREE key at https://cloud.cerebras.ai
CEREBRAS_API_KEY=csk-cvp8433x4xr6yf6t6d655ffe6tkh5hed3nwpe3yyjd4mx3pk

# --- OpenRouter (free model fallback for browser automation) ---
# Get a FREE key at https://openrouter.ai
OPENROUTER_API_KEY=

# --- Browser-Use Cloud (paid, highest accuracy) ---
# Get key at https://cloud.browser-use.com/new-api-key
BROWSER_USE_API_KEY=

# --- Google Gemini (legacy, unused) ---
GEMINI_API_KEY=your-google-gemini-api-key

# --- Groq (free LLM — get key at https://console.groq.com) ---
GROQ_API_KEY=your_groq_api_key_here

# --- Walmart ---
WALMART_EMAIL=your-walmart-email
WALMART_PASSWORD=your-walmart-password

# --- Clerk ---
CLERK_SECRET_KEY=sk_your_clerk_secret
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# --- Sentry ---
SENTRY_DSN=

# --- App ---
ENVIRONMENT=development
DEBUG=true
